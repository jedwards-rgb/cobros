# Copiar a .env.local. Nunca publicar secretos ni utilizar NEXT_PUBLIC_ para ellos.
APP_URL=http://localhost:3000
# Para producción: PostgreSQL privado (por ejemplo Supabase). Vacío solo permite desarrollo local.
DATABASE_URL=
DATABASE_SSL=true
# Si el servidor usa una CA privada, ruta al certificado PEM. No desactivar verificación TLS.
DATABASE_CA_FILE=
SQLITE_PATH=data/cobroedu.sqlite
SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=es
# Secreto aleatorio >=32 caracteres, solo si se usa el endpoint cron.
CRON_SECRET=
